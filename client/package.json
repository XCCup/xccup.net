{
  "name": "xccup-client",
  "version": "0.2.0",
  "private": true,
  "license": "GNU GPLv3",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build-local": "vue-tsc --noEmit && vite build --mode staging",
    "serve": "vite preview --host",
    "preview": "vue-tsc --noEmit && vite build --mode staging && vite preview --host",
    "preview-8000": "vue-tsc --noEmit && vite build --mode staging && vite preview --host --port 8000",
    "cypress-gui": "cypress open",
    "cypress-headless": "cypress run",
    "lint": "eslint --fix src cypress cypress.config.js",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier .  --write",
    "up": "npx taze -I"
  },
  "dependencies": {
    "@sentry/vue": "^10.68.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "glightbox": "^3.3.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "marked": "^18.0.7",
    "metar-parser": "^1.0.1",
    "nprogress": "^0.2.0",
    "sweetalert2": "^11.26.25",
    "v-plausible": "^1.2.0",
    "vue": "^3.5.40",
    "vue-avatar-editor-improved": "^1.0.7",
    "vue-router": "^5.2.0",
    "vue3-datepicker": "^0.4.0",
    "vue3-emoji-picker": "^1.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/bootstrap": "^5.2.11",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
