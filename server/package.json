{
  "name": "xccup-server",
  "version": "0.1.0",
  "description": "The backend server for the xccup",
  "private": true,
  "license": "GNU GPLv3",
  "main": "app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node-dev --poll --respawn --pretty --transpile-only app.ts",
    "docker-dev": "docker compose up",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "up": "docker compose run --rm npm npx taze -I",
    "format": "prettier .  --write",
    "docker-install": "docker compose run --rm npm npm install"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@sentry/node": "^10.68.0",
    "@sentry/profiling-node": "^10.68.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "bs-logger": "^0.2.6",
    "compression": "^1.8.1",
    "convict": "^6.2.5",
    "core-js": "^3.49.0",
    "cors": "^2.8.6",
    "date-easter": "^1.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "flight-recorder-manufacturers": "^2.0.0",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "node-html-parser": "^7.1.0",
    "nodemailer": "^9.0.3",
    "parse-dms": "^0.0.5",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "^2.17.6",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "timekeeper": "^2.3.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/convict": "^6.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0"
}
